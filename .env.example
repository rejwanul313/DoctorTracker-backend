# --- Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB must be a replica set (transactions). `npm run db:up` starts one via Docker.
MONGODB_URI=mongodb://localhost:27017/doctor-tracker?replicaSet=rs0&directConnection=true

# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000

# Seeded admin account (npm run seed)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@123
